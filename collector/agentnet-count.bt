#!/usr/bin/env bpftrace
/*
 * agentnet-count.bt: ablation variant (E3): the SAME probes and the same
 * context-map maintenance as agentnet.bt, but emitting no event to user space
 * (only in-kernel counters). Measures the cost of the probes themselves,
 * separate from the cost of exporting events. Not usable for attribution.
 */

BEGIN
{
	printf("{\"ev\":\"ready\",\"ts\":%llu}\n", nsecs);
}

tracepoint:syscalls:sys_enter_openat
/ strncmp(str(args->filename), "/run/agentctx/", 14) == 0 /
{
	if (strncmp(str(args->filename), "/run/agentctx/begin/", 20) == 0) {
		@ctx[tid] = str(args->filename);
	} else {
		delete(@ctx[tid]);
	}
	@n["marker"] = count();
}

tracepoint:sched:sched_process_fork
{
	@ctx[args->child_pid] = @ctx[args->parent_pid];
	@n["fork"] = count();
}

tracepoint:sched:sched_process_exec
{
	@n["exec"] = count();
}

tracepoint:sched:sched_process_exit
{
	delete(@ctx[tid]);
	@n["exit"] = count();
}

kprobe:tcp_connect
{
	$sk = (struct sock *)arg0;
	if ($sk->__sk_common.skc_family == 2) {
		@n["connect"] = count();
	}
}

tracepoint:sock:inet_sock_set_state
/ args->protocol == 6 && args->family == 2 && args->oldstate == 2 /
{
	@n["tcp_state"] = count();
}

END
{
	clear(@ctx);
}
